{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pluto abbreviated series (Meeus 1998 ch.36)",
  "description": "Coefficient tables for Pluto's heliocentric ecliptic longitude, latitude, and distance as a sum of 43 periodic terms.",
  "type": "object",
  "required": ["source", "arguments", "longitude", "latitude", "radius"],
  "properties": {
    "source": {
      "type": "string",
      "description": "Bibliographic reference for the series."
    },
    "note": {
      "type": "string",
      "description": "Accuracy and applicability notes."
    },
    "arguments": {
      "type": "array",
      "description": "43 argument multiplier rows. Each row contains integer multipliers (j, s, p) for the mean longitudes of Jupiter, Saturn, and Pluto.",
      "items": {
        "type": "object",
        "required": ["j", "s", "p"],
        "properties": {
          "j": { "type": "number", "description": "Jupiter mean longitude multiplier." },
          "s": { "type": "number", "description": "Saturn mean longitude multiplier." },
          "p": { "type": "number", "description": "Pluto mean longitude multiplier." }
        }
      },
      "minItems": 43,
      "maxItems": 43
    },
    "longitude": {
      "type": "array",
      "description": "43 amplitude rows for heliocentric longitude (units: 0.000001 arcseconds).",
      "items": {
        "type": "object",
        "required": ["a", "b"],
        "properties": {
          "a": { "type": "number", "description": "Sine coefficient A." },
          "b": { "type": "number", "description": "Cosine coefficient B." }
        }
      },
      "minItems": 43,
      "maxItems": 43
    },
    "latitude": {
      "type": "array",
      "description": "43 amplitude rows for heliocentric latitude (units: 0.000001 arcseconds).",
      "items": {
        "type": "object",
        "required": ["a", "b"],
        "properties": {
          "a": { "type": "number" },
          "b": { "type": "number" }
        }
      },
      "minItems": 43,
      "maxItems": 43
    },
    "radius": {
      "type": "array",
      "description": "43 amplitude rows for heliocentric distance (units: 0.0000001 AU).",
      "items": {
        "type": "object",
        "required": ["a", "b"],
        "properties": {
          "a": { "type": "number" },
          "b": { "type": "number" }
        }
      },
      "minItems": 43,
      "maxItems": 43
    }
  }
}
